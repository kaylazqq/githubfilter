# 复制为 config/local.env 后填写真实值。config/local.env 已被 .gitignore 忽略。
# 不要在值两侧加多余空格，不要把本文件改成真实凭据后提交。

# GitHub 私有源仓：建议使用 fine-grained token，仅授予 Contents 只读权限。
SOURCE_GIT_USERNAME=x-access-token
SOURCE_GIT_TOKEN=REPLACE_WITH_SOURCE_TOKEN

# 内部目标仓：只授予指定镜像仓写权限。
TARGET_GIT_USERNAME=REPLACE_WITH_CODEHUB_USERNAME
TARGET_GIT_TOKEN=REPLACE_WITH_CODEHUB_TOKEN

# 名称必须与 repositories.json 的 targetUrlEnv 一致。
CODEHUB_COLINK_REPO_URL=https://codehub.example.com/organization/repository.git
